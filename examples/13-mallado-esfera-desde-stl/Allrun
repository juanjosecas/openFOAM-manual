#!/usr/bin/env bash
set -Eeuo pipefail
cd -- "$(dirname -- "$0")"
if [[ ! -f constant/triSurface/sphere.stl ]]; then
    mkdir -p constant/triSurface
    gmsh geometry/sphere.geo -2 -format stl -o constant/triSurface/sphere.stl
fi
exec bash ../../scripts/run_prepared_case.sh --case-dir "$PWD" --method snappy --mesh-only "$@"
