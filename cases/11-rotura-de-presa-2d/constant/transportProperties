// Caso heredado: mantener valores; revisar las diferencias entre Foundation y OpenFOAM.com.
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phases (water air);

water
{
    transportModel  Newtonian;
    nu              [0 2 -1 0 0 0 0] 1e-06; // Viscosidad cinemática [m²/s].
    rho             [1 -3 0 0 0 0 0] 1000; // Densidad [kg/m³].
}

air
{
    transportModel  Newtonian;
    nu              [0 2 -1 0 0 0 0] 1.48e-05; // Viscosidad cinemática [m²/s].
    rho             [1 -3 0 0 0 0 0] 1; // Densidad [kg/m³].
}

sigma           [1 0 -2 0 0 0 0] 0.07; // Tensión superficial [N/m].

