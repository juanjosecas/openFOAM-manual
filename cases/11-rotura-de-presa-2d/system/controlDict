// Caso heredado: mantener valores; revisar las diferencias entre Foundation y OpenFOAM.com.
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     interFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         1; // Duración física [s].

deltaT          0.001; // Paso temporal inicial [s].

writeControl    adjustableRunTime;

writeInterval   0.05; // Frecuencia de escritura según writeControl.

purgeWrite      0; // 0 conserva todas las salidas; N conserva las últimas N.

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo 0.5; // Límite objetivo de Courant.
maxAlphaCo 0.5; // Límite objetivo de Courant de la interfaz.
maxDeltaT 0.005; // Paso máximo [s].

// ************************************************************************* //

functions
{

///////////////////////////////////////////////////////////////////////////

minmaxdomain
{
    type fieldMinMax;

    libs (fieldFunctionObjects);

    enabled true; //true or false

    mode component;

    writeControl timeStep;
    writeInterval 1;

    log true;

    fields (p U alpha.water);
}

///////////////////////////////////////////////////////////////////////////

///////////////////////////////////////////////////////////////////////////
water_in_domain
{

    type            volFieldValue;

    libs (fieldFunctionObjects);
    enabled         true;

    //outputControl     outputTime;
    writeControl   timeStep;
    writeInterval  1;

    writeFields no;

    log             true;

    regionType all;

    operation       volIntegrate;
    fields
    (
        alpha.water
    );
}

///////////////////////////////////////////////////////////////////////////

};
