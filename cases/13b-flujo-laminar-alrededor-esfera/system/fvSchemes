FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    location "system";
    object fvSchemes;
}

// Sin derivada temporal: no cambiar solo deltaT esperando una simulación transitoria.
ddtSchemes { default steadyState; }
gradSchemes { default Gauss linear; }
divSchemes
{
    default none;
    // Convección con reconstrucción mediante gradiente. Se conserva el esquema
    // validado; estudiar primero números de malla y convergencia.
    div(phi,U) bounded Gauss linearUpwind grad(U);
    div((nuEff*dev2(T(grad(U))))) Gauss linear;
}
// Corrección para no ortogonalidad; coherente con la malla snappyHexMesh.
laplacianSchemes { default Gauss linear corrected; }
interpolationSchemes { default linear; }
snGradSchemes { default corrected; }
fluxRequired { default no; p; }
