// NOTA DEL MANUAL: Propiedades del material. nu expresa viscosidad cinematica en m2/s cuando es dimensional; rho densidad en kg/m3.
// No se alteran propiedades ni parametros originales. Consultar la guia de materiales si procede.
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

continuousPhaseName air;

rho.air         1.2;

transportModel  Newtonian;
nu              1e-05;

