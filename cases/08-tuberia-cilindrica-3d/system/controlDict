// NOTA DEL MANUAL: Control de solver, tiempo o iteraciones y escrituras. simpleFoam es estacionario y pimpleFoam transitorio.
// Se conservan todos los parametros numericos y fisicos del caso fuente.
FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}
application pimpleFoam;
startFrom startTime;
startTime 0;
stopAt endTime;
endTime 2;
deltaT 0.001;
adjustTimeStep yes;
maxCo 0.5;
maxDeltaT 0.005;
writeControl adjustableRunTime;
writeInterval 0.01;
purgeWrite 0;
writeFormat binary;
writePrecision 8;
writeCompression off;
timeFormat fixed;
timePrecision 5;
runTimeModifiable true;
