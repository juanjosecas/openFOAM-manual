FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      k;
}

dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 0.375;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 0.375;
    }
    outlet
    {
        type            zeroGradient;
    }
    cow
    {
        type            kLowReWallFunction;
        value           uniform 1e-10;
    }
    groundAndTop
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            empty;
    }
}
