FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      omega;
}

dimensions      [0 0 -1 0 0 0 0];
internalField   uniform 14.0;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 14.0;
    }
    outlet
    {
        type            zeroGradient;
    }
    cow
    {
        type            omegaWallFunction;
        value           uniform 14.0;
    }
    groundAndTop
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            empty;
    }
}
