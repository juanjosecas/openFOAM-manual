// Fragmento OPCIONAL para system/controlDict, dentro de functions { ... }.
// No se activa por estar en esta carpeta. Coordenadas en metros.
// Leer campos U y p; revisar las unidades de p en cada solver.
// Fragmento opcional; no se activa solo por estar en esta carpeta.
caseProbes
{
    // Sondas fijas, no partículas que sigan el flujo.
    type probes;
    // Biblioteca de muestreo.
    libs ("libsampling.so");
    // Solo tendrá efecto si se incorpora el fragmento dentro de functions en controlDict.
    enabled true;
    // Velocidad y presión cinemática; en simpleFoam los registros son iteraciones.
    fields (U p);
    // Coordenadas en metros, a mitad del espesor z=0.0005 m.
    probeLocations
    (
        // Sonda central antes del objeto.
        (0.05 0.01 0.0005)
        // Sonda en la estela, 20 mm después de su cara posterior.
        (0.12 0.01 0.0005)
        // Sonda de recuperación, cerca de la salida.
        (0.18 0.01 0.0005)
    );
}
