// NOTA DEL MANUAL: Fraccion volumetrica de agua: 0 aire, 1 agua; valores intermedios describen la interfaz.
// No cambiar los valores originales sin registrar una variante del caso.
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      alpha.water;
}

dimensions [0 0 0 0 0 0 0];

internalField uniform 0;

boundaryField
{
    waterInlet
    {
        type fixedValue;
        value uniform 1;
    }

    leftWall
    {
        type zeroGradient;
    }

    floor
    {
        type zeroGradient;
    }

    atmosphere
    {
        type inletOutlet;

        inletValue uniform 0;
        value uniform 0;
    }

    frontAndBack
    {
        type empty;
    }
}
