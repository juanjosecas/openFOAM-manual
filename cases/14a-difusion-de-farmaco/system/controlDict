FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    location "system";
    object controlDict;
}

application scalarTransportFoam; // Solver del caso.
startFrom startTime; // Origen del cálculo; startTime usa el valor indicado abajo.
startTime 0;
stopAt endTime;
endTime 200;             // 200 s físicos.
deltaT 1;                // Integración Euler implícita.
adjustTimeStep no; // Ajustar el paso según los límites de Courant.
writeControl runTime;
writeInterval 20;        // Estados 0,20,...,200 s.
purgeWrite 0; // 0 conserva todas las salidas; N conserva las últimas N.
writeFormat ascii;
writePrecision 9;
writeCompression off;
timeFormat general;
timePrecision 8;
runTimeModifiable false;
