FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    location "system";
    object fvSolution;
}

solvers
{
    T
    {
        // scalarTransportFoam v2406 ensambla un sistema de transporte
        // tratado como asimetrico, incluso con U = 0.
        solver PBiCGStab;
        preconditioner DILU;
        tolerance 1e-10;
        relTol 0;
    }
}
SIMPLE
{
    nNonOrthogonalCorrectors 0;
}
