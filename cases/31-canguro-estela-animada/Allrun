#!/usr/bin/env bash
set -Eeuo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
if [[ ! -f constant/polyMesh/points ]]; then
  [[ -f geometry/kangaroo.msh ]] || { echo 'Falta geometry/kangaroo.msh: generar con python3 geometry/build_mesh.py en el host.' >&2; exit 1; }
  gmshToFoam geometry/kangaroo.msh > log.gmshToFoam 2>&1
  changeDictionary > log.changeDictionary 2>&1
fi
checkMesh > log.checkMesh 2>&1 || { tail -n 60 log.checkMesh >&2; exit 1; }
pimpleFoam 2>&1 | tee log.pimpleFoam
