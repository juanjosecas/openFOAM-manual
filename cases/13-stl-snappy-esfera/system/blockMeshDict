FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object blockMeshDict;
}

// Dimensiones en metros. Caja de fondo: 4 m x 4 m x 4 m.
// El STL de ejemplo es una esfera de radio 0.5 m en el origen.
scale 1;

vertices
(
    (-2 -2 -2)
    ( 2 -2 -2)
    ( 2  2 -2)
    (-2  2 -2)
    (-2 -2  2)
    ( 2 -2  2)
    ( 2  2  2)
    (-2  2  2)
);

blocks
(
    // Malla base deliberadamente poco costosa.
    hex (0 1 2 3 4 5 6 7) (24 24 24) simpleGrading (1 1 1)
);

edges ();

boundary
(
    outerBox
    {
        type patch;
        faces
        (
            (0 3 2 1)
            (4 5 6 7)
            (0 1 5 4)
            (1 2 6 5)
            (2 3 7 6)
            (3 0 4 7)
        );
    }
);

mergePatchPairs ();
