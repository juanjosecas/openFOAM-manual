FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      turbulenceProperties;
}

simulationType laminar;

laminar
{
    model           generalizedNewtonian;
    viscosityModel  powerLaw;

    nuMin           1e-6;
    nuMax           1e-2;

    k               1e-4;
    n               0.5;
}
