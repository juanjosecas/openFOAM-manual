// NOTA DEL MANUAL: Velocidad en m/s; boundaryField debe coincidir con los nombres de patches. fixedValue impone velocidad; zeroGradient no fija el valor.
// Mantener la fisica y los valores originales; verificar compatibilidad con la version instalada.
FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}

dimensions [0 1 -1 0 0 0 0];

internalField uniform (0.01 0 0);

boundaryField
{
    inlet
    {
        type fixedValue;
        value uniform (0.01 0 0);
    }

    outlet
    {
        type zeroGradient;
    }

    lowerWall
    {
        type noSlip;
    }

    upperWall
    {
        type noSlip;
    }

    frontAndBack
    {
        type empty;
    }
}
