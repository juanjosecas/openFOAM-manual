FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object sampleDict;
}

// Muestreo de líneas centrales en un plano interior; la cavidad base mide 1 m.
type sets;
libs (sampling);
setFormat raw;
interpolationScheme cellPoint;
fields (U);
sets
(
    horizontal
    {
        type uniform;
        axis x;
        start (0.00001 0.5 0.5);
        end (0.99999 0.5 0.5);
        nPoints 101;
    }
    vertical
    {
        type uniform;
        axis y;
        start (0.5 0.00001 0.5);
        end (0.5 0.99999 0.5);
        nPoints 101;
    }
);
