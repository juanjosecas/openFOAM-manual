FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      turbulenceProperties;
}

simulationType laminar;

laminar
{
    model           generalizedNewtonian;
    viscosityModel  powerLaw;

    nuMin           1e-6; // Viscosidad cinemática efectiva mínima [m²/s].
    nuMax           1e-2; // Viscosidad cinemática efectiva máxima [m²/s].

    k               1e-4; // Consistencia de la ley de potencia; sus unidades dependen de n.
    n               0.5; // Exponente reológico; n < 1 produce adelgazamiento por cizalla fuera de los límites.
}
