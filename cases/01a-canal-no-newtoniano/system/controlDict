// Mantener la fisica y los valores originales; verificar compatibilidad con la version instalada.
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application simpleFoam; // Solver del caso.

startFrom startTime; // Origen del cálculo; startTime usa el valor indicado abajo.

startTime 0;

stopAt endTime;

endTime 1000; // Límite de iteraciones; no representa segundos físicos.

deltaT 1; // Incremento del contador de iteraciones.

writeControl timeStep;

writeInterval 100; // Frecuencia de salida según writeControl; no es necesariamente el paso de cálculo.

purgeWrite 0; // 0 conserva todas las salidas; N conserva las últimas N.

writeFormat ascii;

writePrecision 8;

writeCompression off;

timeFormat general;

timePrecision 6;

runTimeModifiable true;
