{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p_rgh;
}

dimensions [1 -1 -2 0 0 0 0];

internalField uniform 0;

boundaryField
{
    waterInlet
    {
        type fixedFluxPressure;
        value uniform 0;
    }

    leftWall
    {
        type fixedFluxPressure;
        value uniform 0;
    }

    floor
    {
        type fixedFluxPressure;
        value uniform 0;
    }

    atmosphere
    {
        type prghTotalPressure;

        p0 uniform 0;
        value uniform 0;
    }

    frontAndBack
    {
        type empty;
    }
}
