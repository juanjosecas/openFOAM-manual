// NOTA DEL MANUAL: Campo de velocidad en m/s. Revisar conditions de inlet, outlet, walls y los nombres de patches.
// Se conservan todos los parametros numericos y fisicos del caso fuente.
FoamFile
{
    version 2.0;
    format ascii;
    class volVectorField;
    location "0";
    object U;
}

dimensions [0 1 -1 0 0 0 0];

internalField uniform (0.0005 0 0);

boundaryField
{
    inlet
    {
        type fixedValue;
        value uniform (0.0005 0 0);
    }

    outlet
    {
        type zeroGradient;
    }

    lowerWall
    {
        type noSlip;
    }

    upperWall
    {
        type noSlip;
    }

    frontAndBack
    {
        type empty;
    }
}
