// NOTA DEL MANUAL: vertices definen la geometria; blocks define celdas y grading;
// boundary fija patches y condiciones geométricas. Asegurar la orientacion de
// los bloques y correspondencia exacta con las condiciones de 0/U y 0/p.
// Si se edita este archivo, reconstruir la malla con blockMesh y checkMesh.
// Cabecera de lectura: tipo y nombre del archivo; no define la física.
FoamFile
{
    // Versión del formato de archivo, no versión del solver.
    version 2.0;
    // Texto ASCII legible y editable.
    format ascii;
    // Tipo de objeto: diccionario o campo escalar/vectorial por celda.
    class dictionary;
    // Nombre del objeto que OpenFOAM lee.
    object blockMeshDict;
}

// Coordenadas en metros: 1e-6 m = 1 micrómetro. No reescalar dos veces.
scale 1;

// Canal planar de longitud 100 um y abertura nominal 10 um.
// En x=50 um, las paredes están en y=2.5 y 7.5 um: garganta de 5 um.
// La reducción es del 50% de la ALTURA del canal, no una medida clínica
// de estenosis de área o diámetro arterial. No hay un lumen circular aquí.
vertices
(
    // Vértices 0-13 del plano frontal. Cada par define pared inferior/superior
    // a una posición axial: x=0,30,40,50,60,70,100 um.
    // Plano z = 0
    (0        0        0)  // 0
    (0        10e-6    0)  // 1
    (30e-6    0        0)  // 2
    (30e-6    10e-6    0)  // 3
    (40e-6    1.25e-6  0)  // 4
    (40e-6    8.75e-6  0)  // 5
    (50e-6    2.5e-6   0)  // 6
    (50e-6    7.5e-6   0)  // 7
    (60e-6    1.25e-6  0)  // 8
    (60e-6    8.75e-6  0)  // 9
    (70e-6    0        0)  // 10
    (70e-6    10e-6    0)  // 11
    (100e-6   0        0)  // 12
    (100e-6   10e-6    0)  // 13

    // Vértices 14-27: copia posterior para extruir la malla un espesor de 1 um.
    // Con empty, este espesor es de representación, no diámetro de un vaso real.
    // Plano z = 1 micrometro
    (0        0        1e-6)  // 14
    (0        10e-6    1e-6)  // 15
    (30e-6    0        1e-6)  // 16
    (30e-6    10e-6    1e-6)  // 17
    (40e-6    1.25e-6  1e-6)  // 18
    (40e-6    8.75e-6  1e-6)  // 19
    (50e-6    2.5e-6   1e-6)  // 20
    (50e-6    7.5e-6   1e-6)  // 21
    (60e-6    1.25e-6  1e-6)  // 22
    (60e-6    8.75e-6  1e-6)  // 23
    (70e-6    0        1e-6)  // 24
    (70e-6    10e-6    1e-6)  // 25
    (100e-6   0        1e-6)  // 26
    (100e-6   10e-6    1e-6)  // 27
);

// Seis bloques hexaédricos conectados; cada hex enumera ocho vértices.
// Las ternas posteriores son subdivisiones locales (axial, transversal, z).
// Total: (30+10+10+10+10+30)*40*1 = 4000 celdas.
// Conservar subdivisiones compatibles en caras compartidas al refinar.
blocks
(
    // Tramo de entrada, x=0 a 30 um, antes del estrechamiento.
    hex (0 2 3 1 14 16 17 15)
        // 30 celdas axiales, 40 transversales y una en z; grading unitario
        // no añade expansión de tamaños dentro de este bloque.
        (30 40 1) simpleGrading (1 1 1)
    // Primer tramo convergente, x=30 a 40 um.
    hex (2 4 5 3 16 18 19 17)
        (10 40 1) simpleGrading (1 1 1)
    // Segundo tramo convergente, x=40 a 50 um; llega a la garganta.
    hex (4 6 7 5 18 20 21 19)
        (10 40 1) simpleGrading (1 1 1)
    // Primer tramo divergente, x=50 a 60 um.
    hex (6 8 9 7 20 22 23 21)
        (10 40 1) simpleGrading (1 1 1)
    // Segundo tramo divergente, x=60 a 70 um.
    hex (8 10 11 9 22 24 25 23)
        (10 40 1) simpleGrading (1 1 1)
    // Tramo de salida, x=70 a 100 um; recupera la abertura inicial.
    hex (10 12 13 11 24 26 27 25)
        (30 40 1) simpleGrading (1 1 1)
);

// Sin aristas curvas: el estrechamiento tiene paredes por tramos rectos.
edges
(
);

// Agrupa las caras externas no enumeradas en boundary: los planos de z.
defaultPatch
{
    name frontAndBack;
    // Declara la dirección vacía de la malla 2D; coincide con frontAndBack en U y p.
    type empty;
}

// Patches geométricos. type wall identifica paredes; noSlip en 0/U
// las hace inmóviles. No se calcula deformación de la pared vascular.
boundary
(
    // Cara de entrada en x=0.
    inlet
    {
        type patch;
        faces
        (
            (0 14 15 1)
        );
    }
    // Cara de salida en x=100 um.
    outlet
    {
        type patch;
        faces
        (
            (12 13 27 26)
        );
    }
    // Seis caras de la pared inferior, incluidas las pendientes del estrechamiento.
    lowerWall
    {
        type wall;
        faces
        (
            (0 2 16 14)
            (2 4 18 16)
            (4 6 20 18)
            (6 8 22 20)
            (8 10 24 22)
            (10 12 26 24)
        );
    }
    // Seis caras de la pared superior, simétrica respecto de y=5 um.
    upperWall
    {
        type wall;
        faces
        (
            (1 15 17 3)
            (3 17 19 5)
            (5 19 21 7)
            (7 21 23 9)
            (9 23 25 11)
            (11 25 27 13)
        );
    }
);

// Sin fusiones adicionales de patches; los bloques comparten sus interfaces.
mergePatchPairs
(
);
