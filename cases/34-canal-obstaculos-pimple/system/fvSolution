// NOTA DEL MANUAL: Solvers lineales, tolerancias y acoplamiento presion-velocidad; no retirar entradas sin comprobar cuales consulta el solver.
// Mantener la fisica y los valores originales; verificar compatibilidad con la version instalada.
// Cabecera: describe cómo leer el archivo, no sus condiciones físicas.
FoamFile
{
    // Versión del formato, no del solver.
    version 2.0;
    // Texto ASCII editable.
    format ascii;
    // Clase de objeto: diccionario o campo escalar/vectorial por celda.
    class dictionary;
    // Nombre del objeto que lee OpenFOAM.
    object fvSolution;
}

// Solvers de sistemas lineales dentro de cada iteración, no distintos modelos físicos.
solvers
{
    // Sistema de presión cinemática.
    p
    {
        // Multimalla algebraica para presión.
        solver GAMG;
        // Umbral del residual lineal, no tolerancia de error físico del flujo.
        tolerance 1e-8;
        // Permitir terminar al reducir el residual al 1% del inicial.
        relTol 0.01;
        // Suavizador del ciclo multimalla.
        smoother GaussSeidel;
    }

    // Sistema de las componentes de velocidad.
    U
    {
        // Resolución iterativa mediante suavizado.
        solver smoothSolver;
        // Barridos simétricos de Gauss-Seidel.
        smoother symGaussSeidel;
        tolerance 1e-8;
        // Reducción relativa del residual al 10% dentro de esta resolución lineal.
        relTol 0.1;
    }
}

// Acoplamiento presión-velocidad PIMPLE para flujo transitorio.
PIMPLE
{
    nOuterCorrectors 2;
    nCorrectors 2;
    nNonOrthogonalCorrectors 0;
}


// Subrelajación de iteraciones; no modifica viscosidad ni fricción del objeto.
relaxationFactors
{
    fields
    {
        // Amortiguación de las actualizaciones de presión.
        p 0.3;
    }

    equations
    {
        // Subrelajación de la ecuación de velocidad.
        U 0.7;
    }
}
