// NOTA DEL MANUAL: Solvers y acoplamiento presion velocidad; revisar tolerancias y esquemas de fase.
// No cambiar los valores originales sin registrar una variante del caso.
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    "alpha.water.*"
    {
        nAlphaCorr 2;
        nAlphaSubCycles 2;

        cAlpha 1;

        MULESCorr yes;
        nLimiterIter 3;

        solver smoothSolver;
        smoother symGaussSeidel;

        tolerance 1e-8;
        relTol 0;
    }

    "pcorr.*"
    {
        solver PCG;
        preconditioner DIC;

        tolerance 1e-8;
        relTol 0;
    }

    p_rgh
    {
        solver GAMG;
        smoother GaussSeidel;

        tolerance 1e-8;
        relTol 0.05;
    }

    p_rghFinal
    {
        $p_rgh;
        relTol 0;
    }

    U
    {
        solver smoothSolver;
        smoother symGaussSeidel;

        tolerance 1e-7;
        relTol 0.1;
    }

    UFinal
    {
        $U;
        relTol 0;
    }
}

PIMPLE
{
    momentumPredictor no;

    nOuterCorrectors 1;
    nCorrectors 3;

    nNonOrthogonalCorrectors 0;
}
