// NOTA DEL MANUAL: Algoritmos y solvers lineales; las tolerancias influyen en convergencia.
// No se alteran propiedades ni parametros originales. Consultar la guia de materiales si procede.
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    p
    {
        solver GAMG;
        tolerance 1e-8;
        relTol 0.01;
        smoother GaussSeidel;
    }

    U
    {
        solver smoothSolver;
        smoother symGaussSeidel;
        tolerance 1e-8;
        relTol 0.1;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 1;

    consistent no;

    residualControl
    {
        p 1e-6;
        U 1e-7;
    }
}

relaxationFactors
{
    fields
    {
        p 0.3;
    }

    equations
    {
        U 0.7;
    }
}
