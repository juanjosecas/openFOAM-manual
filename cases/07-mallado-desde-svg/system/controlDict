// NOTA DEL MANUAL: Solucion estacionaria simpleFoam; endTime se usa como indice de iteracion, no segundos.
// No cambiar los valores originales sin registrar una variante del caso.
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application simpleFoam;

startFrom startTime;
startTime 0;

stopAt endTime;
endTime 1500;

deltaT 1;

writeControl timeStep;
writeInterval 100;

purgeWrite 0;

writeFormat ascii;
writePrecision 8;
writeCompression off;

timeFormat general;
timePrecision 6;

runTimeModifiable true;
