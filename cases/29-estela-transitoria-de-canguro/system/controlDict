FoamFile { version 2.0; format ascii; class dictionary; object controlDict; }
application pimpleFoam;
startFrom startTime;
startTime 0;
stopAt endTime;
endTime 80;
deltaT 0.002;
adjustTimeStep yes;
maxCo 0.5;
maxDeltaT 0.025;
writeControl adjustableRunTime;
writeInterval 0.5;
purgeWrite 0;
writeFormat binary;
writePrecision 8;
writeCompression off;
timeFormat fixed;
timePrecision 4;
runTimeModifiable true;
functions {
 vorticity {
  type vorticity;
  libs ("libfieldFunctionObjects.so");
  writeControl writeTime;
 }
}
