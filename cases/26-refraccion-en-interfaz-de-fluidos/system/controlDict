FoamFile
{
 version 2.0;
 format ascii;
 class dictionary;
 object controlDict;
}

application interFoam;
startFrom startTime;
startTime 0;
stopAt endTime;
endTime 0.15; // s
deltaT 1e-5; // s
adjustTimeStep yes;
maxCo 0.35;
maxAlphaCo 0.35;
maxDeltaT 2e-4;
writeControl adjustableRunTime;
writeInterval 0.015; // s
purgeWrite 0;
writeFormat ascii;
writePrecision 8;
writeCompression off;
timeFormat fixed;
timePrecision 6;
runTimeModifiable yes;
