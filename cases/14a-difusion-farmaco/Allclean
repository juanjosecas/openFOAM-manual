#!/usr/bin/env bash
set -Eeuo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
if [[ "${1:-}" != "--yes" ]]; then
  echo "Vista previa: borrar constant/polyMesh, log.*, VTK, postProcessing, plots y tiempos físicos > 0."
  echo "Para confirmar: bash Allclean --yes (hacerlo SOLO en una copia del caso)."
  exit 0
fi
rm -rf -- constant/polyMesh VTK postProcessing plots
find . -maxdepth 1 -type f -name 'log.*' -delete
find . -mindepth 1 -maxdepth 1 -type d -regextype posix-extended -regex './[0-9]+(\.[0-9]+)?' ! -name '0' -exec rm -rf -- {} +
