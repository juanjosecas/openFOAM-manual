FoamFile
{
    version 2.0;
    format ascii;
    class volVectorField;
    location "0";
    object U;
}

// Velocidad nula: transporte exclusivamente difusivo.
dimensions [0 1 -1 0 0 0 0];
internalField uniform (0 0 0);
boundaryField
{
    source { type fixedValue; value uniform (0 0 0); }
    farEnd { type fixedValue; value uniform (0 0 0); }
    transverse { type empty; }
}
