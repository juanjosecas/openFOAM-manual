FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    location "system";
    object fvSchemes;
}

ddtSchemes
{
    default Euler;        // Primer orden temporal.
}
gradSchemes
{
    default Gauss linear;
}
divSchemes
{
    default none;
    div(phi,T) Gauss upwind;  // U=0 en esta variante.
}
laplacianSchemes
{
    default Gauss linear corrected;
}
interpolationSchemes
{
    default linear;
}
snGradSchemes
{
    default corrected;
}
