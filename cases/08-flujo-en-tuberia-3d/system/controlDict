FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}
application pimpleFoam; // Solver del caso.
startFrom startTime; // Origen del cálculo; startTime usa el valor indicado abajo.
startTime 0;
stopAt endTime;
endTime 2; // Duración de la simulación [s].
deltaT 0.001; // Paso temporal [s]; inicial si adjustTimeStep está activo.
adjustTimeStep yes; // Ajustar el paso según los límites de Courant.
maxCo 0.5; // Límite objetivo del número de Courant.
maxDeltaT 0.005; // Paso temporal máximo [s].
writeControl adjustableRunTime;
writeInterval 0.01; // Frecuencia de salida según writeControl; no es necesariamente el paso de cálculo.
purgeWrite 0; // 0 conserva todas las salidas; N conserva las últimas N.
writeFormat binary;
writePrecision 8;
writeCompression off;
timeFormat fixed;
timePrecision 5;
runTimeModifiable true;
