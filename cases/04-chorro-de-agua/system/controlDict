FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}

// interFoam: dos fases incompresibles (agua/aire), malla fija.
// Edición objetivo: OpenFOAM.com v2406; sin prueba de ejecución.
application interFoam;

// Iniciar desde los campos originales en 0/.
startFrom startTime;
startTime 0;
stopAt endTime;
endTime 20; // Duración física [s].

// Paso inicial pequeño; el solver puede reducirlo por Courant.
deltaT 1e-5; // Paso temporal inicial [s].
adjustTimeStep yes;
maxCo 0.35; // Límite objetivo de Courant.
maxAlphaCo 0.35; // Límite objetivo de Courant de la interfaz.
maxDeltaT 2e-4; // Paso máximo [s].

// Escribir cada 0.005 s físicos: aproximadamente 4000 escrituras más el estado inicial.
writeControl adjustableRunTime;
writeInterval 0.005; // Frecuencia de escritura según writeControl.
purgeWrite 0; // 0 conserva todas las salidas; N conserva las últimas N.
writeFormat ascii;
writePrecision 8;
writeCompression off;
timeFormat fixed;
timePrecision 6;
runTimeModifiable true;
