#!/usr/bin/env bash
set -Eeuo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
trap 'echo "ERROR: línea $LINENO" >&2' ERR
command -v pimpleFoam >/dev/null || { echo "Cargar OpenFOAM v2406" >&2; exit 1; }
if [[ ! -f constant/polyMesh/points ]]; then
    gmshToFoam ../cow_incompressible_steady/cow_tunnel.msh > log.gmshToFoam 2>&1
    changeDictionary > log.changeDictionary 2>&1
fi
checkMesh > log.checkMesh 2>&1 || echo "AVISO: revisar calidad de malla en log.checkMesh" >&2
grep -Eq 'Mesh OK|Failed 1 mesh checks' log.checkMesh || {
    tail -n 60 log.checkMesh >&2
    exit 1
}
pimpleFoam 2>&1 | tee log.pimpleFoam
