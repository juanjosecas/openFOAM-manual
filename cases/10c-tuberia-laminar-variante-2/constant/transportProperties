// NOTA DEL MANUAL: Propiedades del fluido: nu viscosidad cinematica; los modelos no newtonianos usan sus coeficientes propios.
// Caso heredado: valores conservados y compatibilidad aun no verificada.
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
transportModel  Newtonian;

nu              nu [ 0 2 -1 0 0 0 0 ] 0.01;

