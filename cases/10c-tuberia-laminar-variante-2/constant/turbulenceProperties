// NOTA DEL MANUAL: Seleccion del regimen o modelo de turbulencia.
// Caso heredado: valores conservados y compatibilidad aun no verificada.
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType laminar;

RAS
{
    RASModel        kOmegaSST;

    turbulence      on;

    printCoeffs     on;
}

